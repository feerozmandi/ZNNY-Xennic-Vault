      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "notes": "زمان‌بندی به وقت تهران (GENERIC_TIMEZONE=Asia/Tehran)",
      "notesInFlow": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT chat_id, actor, text_body, iee1405.menu_kb() AS reply_markup\n  FROM iee1405.reminder_items();",
        "options": {}
      },
      "id": "d76f561a-793c-56e4-ba4e-af64da675c63",
      "name": "📋 پیگیری‌های باز",
