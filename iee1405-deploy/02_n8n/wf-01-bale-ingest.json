{
  "name": "IEE1405-01 — دریافت پیام‌های بله",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 20
            }
          ]
        }
      },
      "id": "46fb1037-c664-566a-9c7a-897ed7819a36",
      "name": "⏱ هر ۲۰ ثانیه",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "notes": "هر 20 ثانیه",
      "notesInFlow": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT iee1405.poll_offset() AS \"offset\";",
        "options": {}
      },
      "id": "86efd8b0-59b8-5926-9549-578adf7a7f0e",
      "name": "📍 خواندن offset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      },
      "notes": "offset پایدار در جدول bot_state؛ با ری‌استارت از دست نمی‌رود",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://tapi.bale.ai/bot{{ $env.BALE_BOT_TOKEN }}/getUpdates",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ Number($json.offset) + 1 }}"
            },
            {
              "name": "limit",
              "value": "50"
            },
            {
              "name": "timeout",
              "value": "0"
            }
          ]
        }
      },
      "id": "42f63564-8117-5831-9c30-1ffe515ba429",
      "name": "📥 دریافت پیام‌ها",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "notes": "long-poll = 0 تا اجرای زمان‌بند معطل نماند",
      "notesInFlow": true
    },
    {
      "parameters": {
        "fieldToSplitOut": "result",
        "options": {},
        "include": "noOtherFields"
      },
      "id": "6c5196a8-d20e-5c18-b478-5a332e678e23",
      "name": "✂️ تفکیک آپدیت‌ها",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT chat_id, status, reply_text, org_code\n  FROM iee1405.bot_dispatch($1::bigint, $2::bigint, $3::text, $4::jsonb);",
        "options": {
          "queryReplacement": "={{ [$json.update_id,\n  $json.message.chat.id,\n  ($json.message.text || ''),\n  JSON.stringify($json)] }}"
        }
      },
      "id": "d128a80c-d9f9-59fd-82f1-58a921c49ccb",
      "name": "🧠 پردازش در PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      },
      "notes": "کل منطق ربات داخل تابع SQL است؛ این گره فقط لوله است",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT update_id, chat_id, text_body\n  FROM iee1405.pending_replies(20);",
        "options": {}
      },
      "id": "2fb96d13-281e-5156-ad5d-2c58f7560267",
      "name": "📤 پاسخ‌های آماده ارسال",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      },
      "executeOnce": true,
      "notes": "ارسال تضمین‌شده: اگر بله خطا داد، پیام در اجرای بعدی دوباره فرستاده می‌شود",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://tapi.bale.ai/bot{{ $env.BALE_BOT_TOKEN }}/sendMessage",
        "options": {},
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $json.chat_id }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text_body }}"
            }
          ]
        }
      },
      "id": "f157ef87-fd8e-5691-b221-cf0d4610405d",
      "name": "💬 ارسال پاسخ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT iee1405.mark_delivered($1::bigint);",
        "options": {
          "queryReplacement": "={{ [$json.update_id] }}"
        }
      },
      "id": "14fe4ce9-534c-530e-8174-d4ed9b566aa8",
      "name": "✅ ثبت ارسال",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT iee1405.poll_advance() AS \"offset\";",
        "options": {}
      },
      "id": "2da77d7a-bf69-5651-a877-3246b6353495",
      "name": "⏭ جلو بردن offset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1760,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      },
      "executeOnce": true,
      "notes": "offset از max(update_id) محاسبه می‌شود؛ نه از حافظه n8n",
      "notesInFlow": true
    }
