      "id": "f8555830-4b6f-53c0-87b5-b4040e08285d",
      "name": "⏱ هر ۳۰ دقیقه",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "notes": "زمان‌بندی به وقت تهران (GENERIC_TIMEZONE=Asia/Tehran)",
      "notesInFlow": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT chat_id, text_body, iee1405.menu_kb() AS reply_markup\n  FROM iee1405.health_watch();",
        "options": {}
      },
      "id": "22333e8f-cd60-50f1-9a40-9ef40bf5061e",
      "name": "🩺 بررسی سلامت",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      },
      "notes": "در حالت سالم ساکت است؛ خودترمیمی همیشه اجرا می‌شود",
      "notesInFlow": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text_body }}",
        "replyMarkup": "replyKeyboard",
        "replyKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[0][0].text }}"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[1][0].text }}"
                  },
                  {
                    "text": "={{ $json.reply_markup.keyboard[1][1].text }}"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[2][0].text }}"
                  },
                  {
                    "text": "={{ $json.reply_markup.keyboard[2][1].text }}"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[3][0].text }}"
                  },
                  {
                    "text": "={{ $json.reply_markup.keyboard[3][1].text }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "5bbda83f-584a-5900-9c44-ca0e2c75c167",
