{
  "id": "IEE1405-03",
  "name": "IEE1405-03 — خلاصه پایان روز",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30 20 * * *"
            }
          ]
        }
      },
      "id": "fa9c51a7-72c5-51ab-a0c0-437e3aa1ca90",
      "name": "⏱ هر روز ۲۰:۳۰",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "notes": "زمان‌بندی به وقت تهران (GENERIC_TIMEZONE=Asia/Tehran)",
      "notesInFlow": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "resource": "database",
        "query": "SELECT o.chat_id, iee1405.digest_text() AS text_body,\n       iee1405.menu_kb() AS reply_markup\n  FROM iee1405.owner_chat_ids() o;",
        "options": {}
      },
      "id": "ca8f4215-d68d-57a0-8476-25628e501341",
      "name": "📊 خلاصه روز",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "XENNIC-PG-CREDENTIAL",
          "name": "Xennic PostgreSQL"
        }
      },
      "notes": "متن از v_today_digest ساخته می‌شود (تست‌شده در SQL)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text_body }}",
        "replyMarkup": "replyKeyboard",
        "replyKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[0][0].text }}"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[1][0].text }}"
                  },
                  {
                    "text": "={{ $json.reply_markup.keyboard[1][1].text }}"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[2][0].text }}"
                  },
                  {
                    "text": "={{ $json.reply_markup.keyboard[2][1].text }}"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.reply_markup.keyboard[3][0].text }}"
                  },
                  {
                    "text": "={{ $json.reply_markup.keyboard[3][1].text }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "6560fd3c-5a77-53f4-91f5-7fd0add240a1",
      "name": "💬 ارسال خلاصه",
      "type": "n8n-nodes-bale-messenger-alpha.baleMessenger",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "baleMessengerApi": {
          "id": "XENNIC-BALE-CREDENTIAL",
          "name": "Xennic Bale Bot"
        }
      },
      "notes": "نود رسمی بله — کیبورد اصلی",
      "notesInFlow": true
    }
  ],
  "connections": {
    "⏱ هر روز ۲۰:۳۰": {
