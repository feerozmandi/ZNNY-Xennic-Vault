# ═══════════════════════════════════════════════════════════════════════
# IEE 1405 — نمونه متغیرهای محیطی
# این فایل را روی VPS کنار docker-compose.yml بگذارید با نام ‎.env
# ⚠️ فایل ‎.env هرگز در گیت commit نمی‌شود (در .gitignore هست).
# ⚠️ هیچ رمز یا توکنی در مستندات یا JSON گردش‌کار نوشته نمی‌شود.
# ═══════════════════════════════════════════════════════════════════════

# ── بله ────────────────────────────────────────────────────────────────
# توکن ربات از @BotFather داخل بله گرفته می‌شود.
# کل آدرس پایه را اینجا می‌گذاریم تا توکن نه در n8n و نه در گردش‌کار ذخیره شود.
BALE_API_URL=https://tapi.bale.ai/bot<TOKEN>

# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<STRONG_PASSWORD>
POSTGRES_DB=xennic
# کاربر برنامه (n8n/ربات) — با 03_ops/deploy_sql.sh ساخته می‌شود
IEE_APP_USER=iee_app
IEE_APP_PASSWORD=<STRONG_PASSWORD>

# ── n8n ────────────────────────────────────────────────────────────────
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
N8N_HOST=<vps-host>
N8N_PORT=5678
N8N_PROTOCOL=http
# اگر از دامنه استفاده می‌کنید:
# WEBHOOK_URL=https://n8n.example.com/
# N8N_PROTOCOL=https

# ── نگهداشت ────────────────────────────────────────────────────────────
# EXECUTIONS_DATA_PRUNE=true
# EXECUTIONS_DATA_MAX_AGE=168
